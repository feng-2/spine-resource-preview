{
  "name": "@spine-preview/vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.1.1",
  "publisher": "cceevv",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "spinePreview.open",
        "title": "%command.open.title%",
        "category": "Spine"
      },
      {
        "command": "spinePreview.refresh",
        "title": "%command.refresh.title%",
        "category": "Spine",
        "icon": "$(refresh)"
      },
      {
        "command": "spinePreview.workspace",
        "title": "%command.workspace.title%",
        "category": "Spine",
        "icon": "$(root-folder)"
      },
      {
        "command": "spinePreview.copyName",
        "title": "%command.copyName.title%",
        "category": "Spine"
      },
      {
        "command": "spinePreview.copyPath",
        "title": "%command.copyPath.title%",
        "category": "Spine"
      },
      {
        "command": "spinePreview.copyRelativePath",
        "title": "%command.copyRelativePath.title%",
        "category": "Spine"
      },
      {
        "command": "spinePreview.copyAnimationName",
        "title": "%command.copyAnimationName.title%",
        "category": "Spine",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "spinePreview.open",
          "group": "navigation@90"
        }
      ],
      "view/title": [
        {
          "command": "spinePreview.refresh",
          "when": "view == spinePreview.resources",
          "group": "navigation@1"
        },
        {
          "command": "spinePreview.workspace",
          "when": "view == spinePreview.resources && spinePreview.temporaryScope",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "spinePreview.copyName",
          "when": "view == spinePreview.resources && viewItem =~ /^spinePreview\\.(scope|folder|resource)$/",
          "group": "clipboard@1"
        },
        {
          "command": "spinePreview.copyPath",
          "when": "view == spinePreview.resources && viewItem =~ /^spinePreview\\.(scope|folder|resource)$/",
          "group": "clipboard@2"
        },
        {
          "command": "spinePreview.copyRelativePath",
          "when": "view == spinePreview.resources && viewItem =~ /^spinePreview\\.(scope|folder|resource)$/",
          "group": "clipboard@3"
        },
        {
          "command": "spinePreview.copyAnimationName",
          "when": "view == spinePreview.animations && viewItem == spinePreview.animation",
          "group": "inline@1"
        },
        {
          "command": "spinePreview.copyName",
          "when": "view == spinePreview.animations && viewItem == spinePreview.animation",
          "group": "clipboard@1"
        }
      ],
      "commandPalette": [
        {
          "command": "spinePreview.copyName",
          "when": "false"
        },
        {
          "command": "spinePreview.copyPath",
          "when": "false"
        },
        {
          "command": "spinePreview.copyRelativePath",
          "when": "false"
        },
        {
          "command": "spinePreview.copyAnimationName",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spinePreview",
          "title": "%container.spine.title%",
          "icon": "assets/sidebar.svg"
        }
      ]
    },
    "views": {
      "spinePreview": [
        {
          "id": "spinePreview.resources",
          "name": "%view.resources.title%",
          "icon": "assets/sidebar.svg"
        },
        {
          "id": "spinePreview.animations",
          "name": "%view.animations.title%",
          "icon": "assets/sidebar.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "pnpm build && node package.mjs"
  },
  "dependencies": {
    "@spine-preview/core": "workspace:*",
    "@spine-preview/runtimes": "workspace:*",
    "@spine-preview/viewer": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.28.2",
    "vite": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feng-2/spine-resource-preview.git",
    "directory": "apps/vscode"
  },
  "homepage": "https://feng-2.github.io/spine-resource-preview/",
  "bugs": {
    "url": "https://github.com/feng-2/spine-resource-preview/issues"
  }
}
